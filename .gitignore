# Sample folders: scanner output, customer documents and scratch uploads land
# here, so nothing new is picked up by `git add`. Files already tracked under
# docs/sample/ (test fixtures such as CodeReview_Sample/, MITRE_Sample/) stay
# tracked; add a new fixture deliberately with `git add -f`.
sample/
docs/sample/

# Office files are generated reports or input samples, not source. Tracked
# exceptions stay tracked (apps/web/public/templates/*.xlsx, served as
# downloads and rebuilt by scripts/generate_templates.py); a NEW template
# must be added with `git add -f`.
*.pptx
*.ppt
*.xlsx
*.xls

# Local-only sales helper (one-slide MITRE value pitch); owner keeps it out of the repo.
scripts/build_mitre_value_slide.py
