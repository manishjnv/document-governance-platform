          "ruleId": "CWE-1333: Inefficient Regular Expression Complexity",
          "level": "warning",
          "message": {
            "text": "ReDoS in bankRouting regex on profile update  [CVSS 6.5: CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:N/A:H]"
          },
          "locations": [
            {
              "physicalLocation": {
