        {
          "ruleId": "CWE-352: Cross-Site Request Forgery (CSRF)",
          "level": "warning",
          "message": {
            "text": "Missing CSRF protection on profile update  [CVSS 6.5: CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:N/I:H/A:N]"
          },
          "locations": [
            {
              "physicalLocation": {
