            }
          ],
          "rank": 98.0,
          "partialFingerprints": {
            "vvaFindingId/v1": "vvaf1_c7877d63a00859a526564b4a007d03ed"
          }
        },
        {
          "ruleId": "CWE-1104: Use of Unmaintained Third Party Components",
          "level": "error",
          "message": {
            "text": "EOL Node.js 12 in Docker base image  [CVSS 9.8: CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Dockerfile"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "critical",
            "security-severity": "9.8",
            "cvssRating": "Critical",
            "category": "CWE-1104: Use of Unmaintained Third Party Components",
            "cvssVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H",
            "cwe": "CWE-1104 - Use of Unmaintained Third Party Components",
            "cweId": "CWE-1104",
            "cweName": "Use of Unmaintained Third Party Components",
            "cvssScore": 9.8,
            "offensivePriority": "P3",
            "offensivePriorityLabel": "Internal Network / Privileged Position",
            "offensivePriorityReason": "Internal Network / Privileged Position | *exposure unverified \u2014 no CMDB context; AV:N (network-routable; internet exposure unconfirmed)*",
            "confidence": 0.95,
            "description": "#### Description\nThe Dockerfile uses `FROM node:12-alpine` at line 1 (first stage) and again at line 7 (second stage). Node.js 12 is no longer maintained, exposing any deployed instance to all publicly known Node.js 12 CVEs. The image is not pinned by digest, so future pulls are also unpinned.\n\n#### Impact\nThe application is built on Node.js 12, which reached end-of-life in April 2022 and no longer receives security patches. Remote attackers can exploit known unpatched vulnerabilities in the runtime to execute arbitrary code or cause a denial of service, compromising the entire application server.\n\n#### Exploit scenario\nAn attacker sends a crafted HTTP request that triggers a known Node.js 12 vulnerability (e.g., path traversal or prototype pollution). Because the runtime is unpatched, the request achieves remote code execution on the container, allowing the attacker to steal data, pivot to internal services, or mine cryptocurrency.\n\n#### Preconditions\n- The application is deployed and accessible over the network.\n- A remotely exploitable vulnerability exists in Node.js 12 (many are known and unpatched).\n\n```\nFROM node:12-alpine\n```\n\n#### How to fix\nUpgrade the base image to a supported LTS version such as node:18-alpine or node:20-alpine. Pin the image by digest (e.g., node:20-alpine@sha256:...) to ensure immutable, known-good base layers.\n\n**Exploitability:** Docker base image uses end-of-life Node.js 12, exposing the application to all unpatched CVEs. No deploy-time control mitigates this supply-chain risk.\n\n#### Adversarial verification\n**Verdict:** TRUE_POSITIVE (confidence: 9/10) \u2014 Dockerfile confirmed to use EOL node:12-alpine, built via docker-compose, network-exposed on port 4000, no digest pin or alternative image"
          },
          "taxa": [
            {
              "toolComponent": {
                "name": "CWE",
                "guid": "b7c8d9e0-1f2a-3b4c-5d6e-7f8090a1b2c3"
              },
              "id": "CWE-1104"
            }
          ],
          "rank": 98.0,
          "partialFingerprints": {
            "vvaFindingId/v1": "vvaf1_49bb2411950043c95b37beaeda70af70"
          }
        },
        {
          "ruleId": "CWE-306: Missing Authentication for Critical Function",
          "level": "error",
          "message": {
            "text": "Missing authentication on MongoDB  [CVSS 9.9: CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:H/I:H/A:H]"
          },
