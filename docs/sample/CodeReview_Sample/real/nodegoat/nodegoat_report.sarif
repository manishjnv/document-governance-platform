        {
          "ruleId": "CWE-117",
          "level": "warning",
          "message": {
            "text": "Log injection via unsanitized userName in login error  [CVSS 5.3: CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:N]"
          },
          "locations": [
