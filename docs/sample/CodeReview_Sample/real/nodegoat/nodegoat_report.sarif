        {
          "ruleId": "CWE-384: Session Fixation",
          "level": "warning",
          "message": {
            "text": "Session fixation due to missing session regeneration on login  [CVSS 6.8: CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:U/C:H/I:H/A:N]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/routes/session.js"
                },
                "region": {
                  "startLine": 116
                }
