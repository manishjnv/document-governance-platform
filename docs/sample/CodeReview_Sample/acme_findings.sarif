{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "vvaharness",
          "version": "1.3.0"
        }
      },
      "results": [
        {
          "ruleId": "sql_injection",
          "level": "error",
          "message": {
            "text": "User-supplied merchant_ref is string-formatted directly into a raw SQL query used to look up payment records."
          },
          "properties": {
            "severity": "critical",
            "cwe": "CWE-89",
            "cvssScore": 9.8,
            "cvssVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H",
            "cvssRating": "CRITICAL",
            "confidence": 0.95
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/payments/repository.py"
                },
                "region": {
                  "startLine": 88,
                  "endLine": 94
                }
              }
            }
          ]
        },
        {
          "ruleId": "hardcoded_secret",
          "level": "error",
          "message": {
            "text": "A hardcoded AWS access key/secret pair is committed to the settings module and shipped in every build artifact."
          },
          "properties": {
            "severity": "critical",
            "cwe": "CWE-798",
            "cvssScore": 9.1,
            "cvssVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:L",
            "cvssRating": "CRITICAL",
            "confidence": 0.9
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/config/settings.py"
                },
                "region": {
                  "startLine": 22,
                  "endLine": 23
                }
              }
            }
          ]
        },
        {
          "ruleId": "ssrf",
          "level": "error",
          "message": {
            "text": "The outbound-webhook test endpoint fetches an arbitrary merchant-supplied URL server-side with no destination allowlist."
          },
          "properties": {
            "severity": "high",
            "cwe": "CWE-918",
            "cvssScore": 8.6,
            "cvssVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:C/C:H/I:L/A:N",
            "cvssRating": "HIGH",
            "confidence": 0.85
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/integrations/webhooks.py"
                },
                "region": {
                  "startLine": 55,
                  "endLine": 71
                }
              }
            }
          ]
        },
        {
          "ruleId": "broken_auth",
          "level": "error",
          "message": {
            "text": "jwt.decode() is called with algorithms taken from the token's own header rather than a fixed server-side allowlist, permitting an alg=none token."
          },
          "properties": {
            "severity": "high",
            "cwe": "CWE-347",
            "cvssScore": 8.1,
            "cvssVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:N",
            "cvssRating": "HIGH",
            "confidence": 0.8
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/auth/tokens.py"
                },
                "region": {
                  "startLine": 30,
                  "endLine": 36
                }
              }
            }
          ]
        },
        {
          "ruleId": "path_traversal",
          "level": "error",
          "message": {
            "text": "The invoice-download endpoint builds a filesystem path from a user-supplied filename with only a naive '..' string replace, which does not stop encoded or nested traversal sequences."
          },
          "properties": {
            "severity": "high",
            "cwe": "CWE-22",
            "cvssScore": 7.5,
            "cvssVector": "CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:N/A:N",
            "cvssRating": "HIGH",
            "confidence": 0.82
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/invoices/routes.py"
                },
                "region": {
                  "startLine": 63,
                  "endLine": 70
                }
              }
            }
          ]
        },
        {
          "ruleId": "missing_rate_limit",
          "level": "warning",
          "message": {
            "text": "The OTP verification endpoint has no per-account or per-IP rate limit, allowing an unbounded number of guesses against a 6-digit code."
          },
          "properties": {
            "severity": "medium",
            "cwe": "CWE-799",
            "cvssScore": 5.3,
            "cvssVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:N/A:N",
            "cvssRating": "MEDIUM",
            "confidence": 0.7
