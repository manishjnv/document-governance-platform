          ]
        },
        {
          "ruleId": "info_disclosure",
          "level": "warning",
          "message": {
            "text": "The global exception handler returns the full traceback and local variable dump in the JSON response body for any unhandled exception."
          },
          "properties": {
            "severity": "medium",
            "cwe": "CWE-209",
            "cvssScore": 5.0,
            "cvssVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:N/A:N",
            "cvssRating": "MEDIUM",
            "confidence": 0.75
