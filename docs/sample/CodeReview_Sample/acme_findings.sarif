                }
              }
            }
          ]
        },
        {
          "ruleId": "weak_crypto",
          "level": "note",
          "message": {
            "text": "Passwords are hashed with bcrypt at a cost factor of 4, far below the current recommendation of 12+, making offline brute-force cheaper."
